<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab = pUI accent-soft pill (same as pCalc / pCalendar tabs). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item android:top="6dp" android:bottom="6dp" android:left="4dp" android:right="4dp">
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/p_accent_soft" />
                    <corners android:radius="@dimen/p_radius_pill" />
                </shape>
            </item>
            <item><color android:color="@android:color/transparent" /></item>
        </selector>
    </item>
</ripple>
